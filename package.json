{
  "name": "@alexify/wrpc",
  "version": "2.2.0",
  "description": "wRPC (Web RPC): a fast, zero-dependency RPC protocol for Node.js and browsers - one router over WebSocket, HTTP, SSE, REST, WebTransport and WebRTC, plus message brokers - typed client, subscriptions, rooms, cluster, binary streams, compression and encryption",
  "main": "index.js",
  "browser": {
    "./index.js": "./src/index.browser.js",
    "./src/chunks.js": "./src/chunks.browser.js",
    "./src/runtime/node.js": "./src/runtime/browser.js",
    "./src/compression/native.js": "./src/compression/native.browser.js",
    "./src/client/wsCompression.js": "./src/client/wsCompression.browser.js",
    "./src/client/wsHandshake.js": "./src/client/wsHandshake.browser.js",
    "./src/encryption/aead.js": "./src/encryption/aead.browser.js",
    "./src/encryption/dh.js": "./src/encryption/dh.browser.js",
    "./src/encryption/hkdf.js": "./src/encryption/hkdf.browser.js"
  },
  "imports": {
    "#ws": "./src/websocket/ws.js"
  },
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "ws": [
        "./src/websocket/ws.d.ts"
      ],
      "engine": [
        "./src/engine/index.d.ts"
      ],
      "uws": [
        "./src/adapters/uws.d.ts"
      ],
      "fastify": [
        "./src/adapters/fastify.d.ts"
      ],
      "express": [
        "./src/adapters/express.d.ts"
      ],
      "scaling": [
        "./src/scaling/index.d.ts"
      ],
      "broker": [
        "./src/broker/index.d.ts"
      ],
      "broker/redis": [
        "./src/broker/redis/index.d.ts"
      ],
      "broker/nats": [
        "./src/broker/nats/index.d.ts"
      ],
      "broker/amqp": [
        "./src/broker/amqp/index.d.ts"
      ],
      "broker/kafka": [
        "./src/broker/kafka/index.d.ts"
      ],
      "sse": [
        "./src/sse/index.d.ts"
      ],
      "query": [
        "./src/query/index.d.ts"
      ],
      "auth": [
        "./src/auth/index.d.ts"
      ],
      "deflate": [
        "./src/deflate/index.d.ts"
      ],
      "encryption": [
        "./src/encryption/index.d.ts"
      ],
      "webrtc": [
        "./src/webrtc/index.d.ts"
      ],
      "wt": [
        "./src/webtransport/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./src/index.browser.d.ts",
        "default": "./src/index.browser.js"
      },
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./ws": {
      "types": "./src/websocket/ws.d.ts",
      "default": "./src/websocket/ws.js"
    },
    "./engine": {
      "types": "./src/engine/index.d.ts",
      "default": "./src/engine/index.js"
    },
    "./uws": {
      "types": "./src/adapters/uws.d.ts",
      "default": "./src/adapters/uws.js"
    },
    "./fastify": {
      "types": "./src/adapters/fastify.d.ts",
      "default": "./src/adapters/fastify.js"
    },
    "./express": {
      "types": "./src/adapters/express.d.ts",
      "default": "./src/adapters/express.js"
    },
    "./scaling": {
      "types": "./src/scaling/index.d.ts",
      "default": "./src/scaling/index.js"
    },
    "./broker": {
      "types": "./src/broker/index.d.ts",
      "default": "./src/broker/index.js"
    },
    "./broker/redis": {
      "types": "./src/broker/redis/index.d.ts",
      "default": "./src/broker/redis/index.js"
    },
    "./broker/nats": {
      "types": "./src/broker/nats/index.d.ts",
      "default": "./src/broker/nats/index.js"
    },
    "./broker/amqp": {
      "types": "./src/broker/amqp/index.d.ts",
      "default": "./src/broker/amqp/index.js"
    },
    "./broker/kafka": {
      "types": "./src/broker/kafka/index.d.ts",
      "default": "./src/broker/kafka/index.js"
    },
    "./sse": {
      "browser": {
        "types": "./src/sse/client.d.ts",
        "default": "./src/sse/client.js"
      },
      "types": "./src/sse/index.d.ts",
      "default": "./src/sse/index.js"
    },
    "./query": {
      "types": "./src/query/index.d.ts",
      "default": "./src/query/index.js"
    },
    "./auth": {
      "types": "./src/auth/index.d.ts",
      "default": "./src/auth/index.js"
    },
    "./deflate": {
      "types": "./src/deflate/index.d.ts",
      "default": "./src/deflate/index.js"
    },
    "./encryption": {
      "browser": {
        "types": "./src/encryption/browser.d.ts",
        "default": "./src/encryption/browser.js"
      },
      "types": "./src/encryption/index.d.ts",
      "default": "./src/encryption/index.js"
    },
    "./webrtc": {
      "browser": {
        "types": "./src/webrtc/browser.d.ts",
        "default": "./src/webrtc/browser.js"
      },
      "types": "./src/webrtc/index.d.ts",
      "default": "./src/webrtc/index.js"
    },
    "./wt": {
      "types": "./src/webtransport/index.d.ts",
      "default": "./src/webtransport/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wrpc": "bin/wrpc.js"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 95 --statements 95 --branches 90 --functions 95 --reporter text --reporter lcov node --test",
    "test:ci": "c8 --all --include 'src/**' --check-coverage --lines 95 --statements 95 --branches 90 --functions 95 --reporter text --reporter lcov node --test --test-timeout=300000 --test-force-exit",
    "test:coverage:floors": "node scripts/coverage-floors.js",
    "test:types": "tsd",
    "test:perf": "node tests/perf/stream-memory.perf.js",
    "bench": "node bench/run-all.js",
    "bench:browser": "node scripts/bench-browser.js",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "brokers:up": "docker compose up -d",
    "brokers:down": "docker compose down",
    "lint": "oxlint --report-unused-disable-directives-severity=error src tests scripts bench bin examples",
    "format": "oxfmt src tests scripts bench bin examples",
    "format:check": "oxfmt --check src tests scripts bench bin examples",
    "size": "node scripts/size.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "alexiskills claude",
    "prepublishOnly": "pnpm run lint && pnpm run format:check && pnpm run test:ci && pnpm run test:coverage:floors && pnpm run test:types && pnpm run size && pnpm run docs:build"
  },
  "tsd": {
    "directory": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/wrpc.git"
  },
  "keywords": [
    "wrpc",
    "websocket",
    "rpc",
    "protocol",
    "nodejs",
    "browser",
    "fast",
    "zero-dependency",
    "authentication",
    "realtime",
    "communication",
    "messaging",
    "remote-procedure-call",
    "rpc-framework",
    "websocket-rpc",
    "typescript",
    "javascript",
    "node",
    "opentelemetry",
    "observability",
    "sse",
    "server-sent-events",
    "rest",
    "typed-client",
    "codegen",
    "tanstack-query",
    "subscriptions",
    "pubsub",
    "cluster",
    "streams",
    "webrtc",
    "peer-to-peer",
    "data-channel",
    "webtransport",
    "http3",
    "quic",
    "message-broker",
    "broker",
    "kafka",
    "rabbitmq",
    "amqp",
    "nats",
    "jetstream",
    "redis-streams",
    "queue",
    "consumer",
    "event-driven",
    "durable-feed"
  ],
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/wrpc/issues"
  },
  "homepage": "https://wrpc.vercel.app",
  "devDependencies": {
    "@alexify/metaskills": "^1.2.0",
    "@confluentinc/kafka-javascript": "^1.10.1",
    "@fails-components/webtransport": "^1.6.8",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.8",
    "@fastify/websocket": "^11.3.0",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@tanstack/query-core": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/node": "^22.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "amqplib": "^2.0.1",
    "autocannon": "^8.0.0",
    "c8": "^10.1.3",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "fastify": "^5.11.3",
    "fastify-uws": "^2.0.0",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "mermaid": "^11.16.0",
    "node-datachannel": "^0.33.4",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.63.0",
    "quico": "^0.4.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsd": "^0.33.0",
    "typescript": "^7.0.2",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.69.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "wrpc-v1": "npm:@alexify/wrpc@1.0.0",
    "wrpc-v2": "npm:@alexify/wrpc@2.0.1",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "index.js",
    "index.d.ts",
    "bin/",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "package.json",
    "!**/CLAUDE.md"
  ]
}
